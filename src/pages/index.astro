---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Callout from '../components/Callout.astro';
import ItemList from '../components/ItemList.astro';
import { pages } from '../data/pages';
import { u } from '../lib/utils';
const page = pages.home;
---
<Base title={page.title} description={page.description} path="/">
  <Hero headline={page.headline} intro={page.intro} location="Homepage" />
  <section class="content-section"><div class="content-inner split-section">
    <div>
      <h2 class="section-title">{page.sectionTitle}</h2>
      <p class="section-intro">{page.sectionText}</p>
      <div style="margin-top:27px"><a class="text-link" href={u(page.related.href)}>{page.related.label}<span aria-hidden="true">&#8599;</span></a></div>
    </div>
    <div class="signal-panel"><div class="signal-big">Built around the inside of the pipe.</div></div>
  </div></section>
  <section class="content-section" style="background:#eeece2"><div class="content-inner">
    <h2 class="section-title">Different lines. One clear specialty.</h2>
    <ItemList items={page.items} />
    <div style="margin-top:28px"><a class="text-link" href={u('/services')}>Explore hydro jetting services <span aria-hidden="true">&#8599;</span></a></div>
  </div></section>
  <Callout />
</Base>
