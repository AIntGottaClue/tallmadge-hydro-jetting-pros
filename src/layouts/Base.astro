---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_URL, business } from '../lib/site';
import { pageSchema } from '../lib/seo';
import { siteConfig } from '../data/siteConfig';
import { u } from '../lib/utils';
const { title, description, path, crumbs = [], extraSchema = [] } = Astro.props;
const canonical = `${SITE_URL}${path === '/' ? '/' : path}`;
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d3439" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={business.name} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${siteConfig.ga4MeasurementId}`}></script>
    <script is:inline define:vars={{ id: siteConfig.ga4MeasurementId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', id);
    </script>
    <JsonLd data={pageSchema(path, title, description, crumbs)} />
    {extraSchema.map((s) => <JsonLd data={s} />)}
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <script>import '../scripts/lead-form.js';</script>
    <script is:inline defer src="https://api.airchatty.com/js/external-tracking.js" data-tracking-id={siteConfig.airchattyTrackingId}></script>
  </body>
</html>
